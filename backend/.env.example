# Thooku Madurai — Backend Environment Variables (copy to .env and fill in)
# NEVER commit .env to git. (Real secrets previously here were redacted —
# rotate Mongo password, Exotel key, Razorpay keys, Gmail app password if
# this repo was ever public.)
FLASK_ENV=development
PORT=5000
JWT_SECRET=change-this-to-a-random-secret

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Firebase Phone Auth (OTP) — replaces Exotel for OTP login
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Road-distance routing (OSRM) for delivery fee calculation
OSRM_URL=http://localhost:5001
OSRM_TIMEOUT_SECONDS=3

# WebRTC calling — Coturn TURN server for NAT traversal
TURN_SERVER_URL=turn:your-server-ip:3478
TURN_SERVER_USERNAME=your_coturn_username
TURN_SERVER_CREDENTIAL=your_coturn_password

# Razorpay (use test keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MOCK_MODE=

# Gmail (optional backup notifications)
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password
