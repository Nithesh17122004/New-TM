# ============================================================
# THOOKU MADURAI — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git! (This file was previously committed
# with real live secrets — those have been redacted here. If
# this repo is/was public, rotate: Mongo password, Exotel key,
# Razorpay keys, Gmail app password — assume they are compromised.)
# ============================================================

# ===== APPLICATION =====
FLASK_ENV=production
FLASK_APP=app.py
PORT=8000
JWT_SECRET=change-this-to-a-long-random-secret
ALLOWED_ORIGINS=https://thookumadurai.in,https://www.thookumadurai.in

# ===== DATABASE =====
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
REDIS_URL=redis://default:password@redis-host:6379

# ===== RAZORPAY (UPI Payments) =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PAYMENT_MOCK_MODE=

# ===== GOOGLE MAPS =====
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===== CLOUDINARY (Image Storage) =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== WHATSAPP CLOUD API (order/rider notifications) =====
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ===== FIREBASE PHONE AUTH (OTP login — replaces Exotel OTP) =====
# Path to your Firebase service account JSON on the server (never commit it).
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# Alternative: paste the whole JSON as one line here instead of using a file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ===== ROAD-DISTANCE ROUTING (OSRM — delivery fee calculation) =====
# Point this at your self-hosted OSRM instance in production. Defaults to the
# public demo server if unset, which is fine for early testing only.
OSRM_URL=http://localhost:5001
OSRM_TIMEOUT_SECONDS=3

# ===== WEBRTC CALLING (Coturn TURN server for NAT traversal) =====
TURN_SERVER_URL=turn:your-server-ip:3478
TURN_SERVER_USERNAME=your_coturn_username
TURN_SERVER_CREDENTIAL=your_coturn_password

# ===== EMAIL (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# ===== SENTRY (Error Monitoring) =====
SENTRY_DSN=https://xxxx@sentry.io/yyyy

# ===== GOOGLE ANALYTICS =====
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== ADMIN CREDENTIALS =====
ADMIN_EMAIL=admin@thookumadurai.in
ADMIN_PASSWORD_HASH=$2b$12$xxxxxxxxxxxxxxxxxxxxx

# Call TURN relay (Xirsys) — required for calls to work over mobile data.
# Get these from https://global.xirsys.net/dashboard
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=

# Call recording storage (Cloudflare R2 — S3-compatible, cheap, generous free tier)
# Leave blank to fall back to local disk storage (NOT persistent on most hosts —
# set these before relying on call recordings for anything you need to keep).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=call-recordings

# Flask session-signing secret (separate from JWT_SECRET) — required, no default
SECRET_KEY=change-this-to-a-long-random-secret

# Comma-separated list of allowed CORS origins (no '*' in production)
CORS_ALLOWED_ORIGINS=https://thookumadurai.in,https://www.thookumadurai.in,https://new-tm-knk1.onrender.com,capacitor://localhost,http://localhost,ionic://localhost

# Recovery admin (used only if the 'admins' collection lookup fails) —
# no credentials are hardcoded in source. Set the same values on Render.
FALLBACK_ADMIN_EMAIL=
FALLBACK_ADMIN_PASSWORD=

# Payments: leave empty to auto-mock while no real Instamojo keys are set.
# Set to 1/true to force mock, 0/false to force real (once keys are added).
PAYMENT_MOCK_MODE=
